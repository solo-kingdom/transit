# Caddyfile - 文件中转服务读写分离配置
# 
# 架构说明：
# - 后端服务（transit）监听 127.0.0.1:9000
# - Caddy 作为反向代理，通过不同端口和方法控制读写权限
# - 容器暴露端口：
#   - 写端口 9202（仅允许 POST/PUT）
#   - 读端口 9201（仅允许 GET/HEAD）
#   - 读写端口 9200（支持所有方法）

{
    # 全局配置
    admin off
    auto_https off
}

# 写端口（9202）- 仅允许 POST 和 PUT 方法
:9202 {
    # 拒绝非允许的请求（非公共路径的 GET，且非 POST/PUT）
    @denied {
        expression !({path} in ['/', '/health'] && {method} == 'GET' || {method} in ['POST', 'PUT'])
    }
    
    respond @denied "Method Not Allowed" 405 {
        close
    }
    
    # 转发到后端服务
    reverse_proxy 127.0.0.1:9000
}

# 读端口（9201）- 仅允许 GET 和 HEAD 方法
:9201 {
    # 拒绝非 GET/HEAD 请求
    @denied {
        expression !({method} in ['GET', 'HEAD'])
    }

    respond @denied "Method Not Allowed" 405 {
        close
    }

    # 转发到后端服务
    reverse_proxy 127.0.0.1:9000
}

# 服务端口（9200）- 同时支持读写
:9200 {
    # 允许所有方法
    reverse_proxy 127.0.0.1:9000
}

# 可选：标准 HTTP 端口配置（同时支持读写）
# 取消注释以下配置以启用 80 端口
# :80 {
#     # 允许所有方法
#     reverse_proxy transit:8000
# }
