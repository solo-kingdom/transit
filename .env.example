# 文件中转服务配置示例
# 复制此文件为 .env 并根据需要修改

# 服务配置
APP_NAME=File Transit Service
APP_VERSION=0.1.0

# 数据存储路径
DATA_DIR=/app/transit/data

# 服务端口（单一端口，读写分离由 Caddy 控制）
PORT=8000

# 文件大小限制（字节），默认 5GB
MAX_FILE_SIZE=5368709120

# 安全配置
# 是否移除文件执行权限
REMOVE_EXEC_PERMISSION=true

# 下载 Host 配置
# 如果为空，则自动获取本机 IP
# 注意：使用 Caddy 时，外部访问端口为 80（HTTP）
# DOWNLOAD_HOST=example.com
# DOWNLOAD_HOST=192.168.1.100

# 认证配置
# 是否启用认证（true/false）
AUTH_ENABLED=false

# 读 token（用于下载文件和查询元信息）
# 多个 token 用逗号分隔
# READ_TOKENS=token1,token2,token3

# 写 token（用于上传文件）
# 多个 token 用逗号分隔
# WRITE_TOKENS=token1,token2,token3

# 示例：设置读写 token
# AUTH_ENABLED=true
# READ_TOKENS=read123,read456
# WRITE_TOKENS=write123,write456

# Caddy 读写分离说明：
# - 写端口 8000：仅允许 POST/PUT 方法（上传文件）
# - 读端口 8001：仅允许 GET/HEAD 方法（下载文件和查询元信息）
# - 读写端口 8080：同时支持读写（适用于需要完整功能的场景）
