# 文件中转服务配置示例
# 复制此文件为 .env 并根据需要修改

# 服务配置
APP_NAME=File Transit Service
APP_VERSION=0.1.0

# 数据存储路径
DATA_DIR=./data

# 读写端口配置
# 写端口（上传）
WRITE_PORT=8000

# 读端口（下载）- 如果为空，则读写使用同一端口
# READ_PORT=8001

# 文件名编码长度
ENCODE_LENGTH=16

# 文件大小限制（字节），默认 100MB
MAX_FILE_SIZE=104857600

# 安全配置
# 是否移除文件执行权限
REMOVE_EXEC_PERMISSION=true
