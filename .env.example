# 文件中转服务配置示例
# 复制此文件为 .env 并根据需要修改

# 服务配置
APP_NAME=File Transit Service
APP_VERSION=0.1.0

# 数据存储路径
DATA_DIR=./data

# 读写端口配置
# 写端口（上传）
WRITE_PORT=8000

# 读端口（下载）- 如果为空，则读写使用同一端口
# READ_PORT=8001

# 文件大小限制（字节），默认 100MB
MAX_FILE_SIZE=104857600

# 安全配置
# 是否移除文件执行权限
REMOVE_EXEC_PERMISSION=true

# 下载 Host 配置
# 如果为空，则自动获取本机 IP
# DOWNLOAD_HOST=192.168.1.100
# DOWNLOAD_HOST=example.com

# 认证配置
# 是否启用认证（true/false）
AUTH_ENABLED=false

# 读 token（用于下载文件和查询元信息）
# 多个 token 用逗号分隔
# READ_TOKENS=token1,token2,token3

# 写 token（用于上传文件）
# 多个 token 用逗号分隔
# WRITE_TOKENS=token1,token2,token3

# 示例：设置读写 token
# AUTH_ENABLED=true
# READ_TOKENS=read123,read456
# WRITE_TOKENS=write123,write456
